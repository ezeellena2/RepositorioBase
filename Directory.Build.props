<!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
<Project>
  <Import Project="$(MSBuildThisFileDirectory)build\DatabaseProvider.props" Condition="Exists('$(MSBuildThisFileDirectory)build\DatabaseProvider.props')" />
  <Import Project="$(MSBuildThisFileDirectory)build\ClientFramework.props" Condition="Exists('$(MSBuildThisFileDirectory)build\ClientFramework.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Suppress NU1608 until Npgsql.EntityFrameworkCore.PostgreSQL 10.0.0 is released -->
    <WarningsNotAsErrors>NU1608</WarningsNotAsErrors>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DatabaseProvider)' == 'PostgreSQL'">
    <DefineConstants>$(DefineConstants);UsePostgreSQL</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DatabaseProvider)' == 'SqlServer'">
    <DefineConstants>$(DefineConstants);UseSqlServer</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DatabaseProvider)' == 'Sqlite'">
    <DefineConstants>$(DefineConstants);UseSqlite</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ClientFramework)' == 'React'">
    <DefineConstants>$(DefineConstants);UseReact</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ClientFramework)' == 'Angular'">
    <DefineConstants>$(DefineConstants);UseAngular</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ClientFramework)' == 'ApiOnly'">
    <DefineConstants>$(DefineConstants);UseApiOnly</DefineConstants>
  </PropertyGroup>
</Project>
