# For more info on HTTP files go to https://aka.ms/vs/httpfile
@Web_HostAddress = https://localhost:5001

# Supply credentials for an existing confirmed account. The template does not seed a default administrator.
@Email=<ExistingAccountEmail>
@Password=<ExistingAccountPassword>
@AntiforgeryToken=<RequestTokenFromBootstrap>
@AntiforgeryCookie=<HostXsrfCookieValue>
@SessionCookie=<HostSessionCookieValue>

# GET antiforgery bootstrap. Copy the JSON requestToken and __Host-XSRF-TOKEN response cookie.
GET {{Web_HostAddress}}/api/identity/antiforgery

###

# POST session. Use the bootstrap request token/cookie and the exact HTTPS origin.
POST {{Web_HostAddress}}/api/identity/sessions
Origin: {{Web_HostAddress}}
X-CSRF-TOKEN: {{AntiforgeryToken}}
Cookie: __Host-XSRF-TOKEN={{AntiforgeryCookie}}
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

###

# GET current identity context after copying the issued __Host-ia-auth cookie.
GET {{Web_HostAddress}}/api/identity/context
Cookie: __Host-ia-auth={{SessionCookie}}
